[Unit]
Description=vhost-admin: Honigtopf-Logs stuendlich auswerten

[Timer]
# Stuendlich: Fertige Tage stehen in der Datenbank und werden uebersprungen, ein Lauf
# rechnet also nur den laufenden Tag nach (unter einer Sekunde). So zeigt die Ansicht
# "heute" hoechstens eine Stunde alt. Faellt ein Lauf in die Logrotation, erkennt er
# das und speichert nichts (siehe Honeypot\LogFiles).
OnCalendar=*-*-* *:20:00
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
